<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="6dp"
    android:background="@color/card_bg" android:layout_margin="4dp">
    <ImageView android:id="@+id/ivCover"
        android:layout_width="match_parent" android:layout_height="180dp"
        android:background="@color/divider" android:scaleType="centerCrop" android:contentDescription="封面" />
    <TextView android:id="@+id/tvTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="@color/fg" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end" android:paddingTop="4dp" />
    <TextView android:id="@+id/tvAuthor"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="@color/muted"
        android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/tvProgress"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="10sp" android:textColor="@color/accent" android:visibility="gone" />
</LinearLayout>
