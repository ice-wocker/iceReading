<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">
    <TextView android:id="@+id/tvTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp"
        android:textSize="16sp" android:textColor="@color/accent" android:textStyle="bold" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
    <ListView android:id="@+id/lv"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:divider="@color/divider" android:dividerHeight="1dp" />
    <Button android:id="@+id/btnAdd"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="+ 添加"
        android:textColor="#FFFFFF" android:background="@color/accent" android:layout_margin="8dp" />
</LinearLayout>
